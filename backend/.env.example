DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yoga_pilates?schema=public"
JWT_SECRET="change-me"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ANNUAL_ID="price_..."
STRIPE_CHECKOUT_SUCCESS_URL="https://example.com/subscription/success"
STRIPE_CHECKOUT_CANCEL_URL="https://example.com/subscription/cancel"
CDN_BASE_URL="https://cdn.example.com"

# Push notifications — Android via Firebase Cloud Messaging.
# Firebase console → Project settings → Service accounts → Generate new
# private key. Paste the ENTIRE downloaded JSON file as a single-line string.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Push notifications — iOS via APNs, token-based (.p8) auth.
# Apple Developer → Certificates, IDs & Profiles → Keys → create a key with
# "Apple Push Notifications service (APNs)" enabled, download the .p8 once
# (Apple won't let you re-download it).
# APNS_KEY: contents of the .p8 file (either paste the PEM text itself, with
# \n for line breaks, or give a filesystem path to the .p8 file).
# APNS_KEY_ID: the 10-character key ID shown next to the key you created.
# APNS_TEAM_ID: your Apple Developer Team ID (Membership page).
# APNS_BUNDLE_ID: the iOS app's bundle identifier (must match Xcode).
# APNS_PRODUCTION: "false" while testing via TestFlight/dev builds against
# the sandbox APNs environment, "true" once shipping to the App Store.
APNS_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID=""
APNS_PRODUCTION="false"

# Support messages: saved to the DB either way; these enable the email
# notification on top of that. Any SMTP provider works (Gmail app password,
# SendGrid/Postmark/Resend SMTP relay, etc). Leave unset to skip the email
# and rely on the DB alone.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@yoga-pilates-app.local"
SUPPORT_NOTIFICATION_EMAIL=""

# Admin panel (GET /admin) — HTTP Basic Auth, one shared login. Pick your
# own values; the panel refuses all requests until both are set.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
